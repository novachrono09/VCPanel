<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- MODE 1: COLLAPSED IN-GAME HUD PILL -->
    <LinearLayout
        android:id="@+id/layoutCollapsed"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_tactical_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <View
            android:id="@+id/pillStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_status" />

        <TextView
            android:id="@+id/pillSquadCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:text="COMMS"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pillQuickMuteBtn"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_tactical_pill"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="MIC ON"
            android:textColor="#00F59B"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- MODE 2: EXPANDED TACTICAL CONTROL DECK -->
    <LinearLayout
        android:id="@+id/layoutExpanded"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tactical_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Header Bar (Draggable Handle) -->
        <LinearLayout
            android:id="@+id/headerDragArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/headerStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/txtRoomTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="SQUAD // 96K OPUS"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCollapse"
                android:layout_width="26dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_tactical_pill"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="—"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#1E232D" />

        <!-- Tactical 2x2 Quick Action Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnToggleMic"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_pill"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="MIC: ON"
                android:textColor="#00F59B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnToggleDeafen"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_pill"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="DEAF: OFF"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAudioRoute"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_pill"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="OUT: SPKR"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_pill"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="LEAVE"
                android:textColor="#FF3B5C"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="monospace"
            android:text="SQUAD CHANNELS (VOL 0-200%)"
            android:textColor="#64748B"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Dynamic Container for Per-Friend Volume Sliders & Speaking Indicators -->
        <LinearLayout
            android:id="@+id/squadListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</FrameLayout>
