<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ================================================================== -->
    <!-- MODE A: EDGE SLIDER HANDLE (Slim Edge Tab Docked to Mobile Border) -->
    <!-- ================================================================== -->
    <FrameLayout
        android:id="@+id/layout_hud_collapsed"
        android:layout_width="18dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_edge_tab_left"
        android:clickable="true"
        android:focusable="false"
        android:visibility="visible">

        <!-- Center Tactile Grip / Active Voice LED Strip -->
        <View
            android:id="@+id/edge_tab_indicator"
            android:layout_width="3dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/indicator_voice_led" />
    </FrameLayout>

    <!-- ================================================================== -->
    <!-- MODE B: EXPANDED CONTROL DECK (272dp Tactical Command Module)      -->
    <!-- ================================================================== -->
    <LinearLayout
        android:id="@+id/layout_hud_expanded"
        android:layout_width="272dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hud_chassis_left"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <!-- 1. HEADER BAR: Drag Handle, Channel ID, Dots Toggle, Mode Switch, Collapse -->
        <LinearLayout
            android:id="@+id/deck_header_drag_zone"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tactile Grip Matrix -->
            <LinearLayout
                android:id="@+id/deck_drag_handle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="2dp"
                android:paddingRight="6dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="#464E62" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="2dp"
                    android:background="#464E62" />
            </LinearLayout>

            <!-- Room / Channel Title -->
            <TextView
                android:id="@+id/deck_channel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="CH // SQUAD-1"
                android:textColor="#F0F4F8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Speaking Dots Toggle Button with Radio Dot Icon -->
            <TextView
                android:id="@+id/deck_btn_toggle_dots"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_chip_channel"
                android:clickable="true"
                android:drawableLeft="@drawable/ic_radio_dot"
                android:drawablePadding="3dp"
                android:focusable="false"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="DOTS:ON"
                android:textColor="#00F58A"
                android:textSize="8sp"
                android:textStyle="bold" />

            <!-- Audio Mode Switcher Badge (OPEN MIC vs PTT) -->
            <TextView
                android:id="@+id/deck_bitrate_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_badge_telemetry"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="OPEN // 96K"
                android:textColor="#00F58A"
                android:textSize="8sp"
                android:textStyle="bold" />

            <!-- Collapse Trigger Button with Dynamic Directional Chevron -->
            <ImageView
                android:id="@+id/deck_btn_collapse"
                android:layout_width="24dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_chip_channel"
                android:clickable="true"
                android:focusable="false"
                android:padding="3dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chevron_collapse" />
        </LinearLayout>

        <!-- Structural Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="#262C3A" />

        <!-- 2. QUICK ACTION GRID (4 Tactile Keycaps with Modern Vector Icons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Action 1: Mic Toggle / PTT Keycap -->
            <LinearLayout
                android:id="@+id/btn_toggle_mic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactile_toggle"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/icon_state_mic"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mic_on" />

                <TextView
                    android:id="@+id/txt_state_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="LIVE"
                    android:textColor="#00F58A"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Action 2: Deafen Toggle Keycap -->
            <LinearLayout
                android:id="@+id/btn_toggle_deafen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactile_toggle"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/icon_state_deafen"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_headset" />

                <TextView
                    android:id="@+id/txt_state_deafen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="NORM"
                    android:textColor="#7C869B"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Action 3: Audio Route Toggle Keycap -->
            <LinearLayout
                android:id="@+id/btn_toggle_route"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactile_toggle"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/icon_state_route"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_speaker" />

                <TextView
                    android:id="@+id/txt_state_route"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="SPKR"
                    android:textColor="#00F58A"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Action 4: Disconnect Keycap -->
            <LinearLayout
                android:id="@+id/btn_disconnect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tactile_danger"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_power_exit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="EXIT"
                    android:textColor="#FF2A4B"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. DUAL-TAB NAVIGATION (ROSTER vs CHANNELS WITH VECTOR ICONS) -->
        <LinearLayout
            android:id="@+id/deck_tab_bar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Tab 1: Roster -->
            <TextView
                android:id="@+id/tab_btn_roster"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_button"
                android:clickable="true"
                android:drawableLeft="@drawable/ic_group_roster"
                android:drawablePadding="5dp"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="ROSTER"
                android:textColor="#FF5500"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Tab 2: Channels -->
            <TextView
                android:id="@+id/tab_btn_channels"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_button"
                android:clickable="true"
                android:drawableLeft="@drawable/ic_radio_channels"
                android:drawablePadding="5dp"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="CHANNELS"
                android:textColor="#7C869B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TAB CONTENT 1: SQUAD ROSTER & GAIN TELEMETRY -->
        <LinearLayout
            android:id="@+id/deck_tab_content_roster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="SQUAD TELEMETRY"
                    android:textColor="#7C869B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="GAIN 0-200%"
                    android:textColor="#464E62"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Dynamic Roster Container -->
            <LinearLayout
                android:id="@+id/deck_roster_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Roster Footer: 1-Tap Copy Invite & Ping Telemetry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/deck_btn_copy_invite"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_channel"
                    android:clickable="true"
                    android:drawableLeft="@drawable/ic_copy_clipboard"
                    android:drawablePadding="6dp"
                    android:focusable="false"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical|center_horizontal"
                    android:includeFontPadding="false"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="COPY LINK"
                    android:textColor="#F0F4F8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Live RTT Ping Telemetry Box -->
                <TextView
                    android:id="@+id/deck_ping_readout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_badge_telemetry"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="LIVE"
                    android:textColor="#00F58A"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- TAB CONTENT 2: CHANNELS & DIRECT FREQUENCY HOP -->
        <LinearLayout
            android:id="@+id/deck_tab_content_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Subheader: Switch Frequency -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="SWITCH FREQUENCY BY CODE"
                    android:textColor="#7C869B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deck_active_room_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="#SQ-884"
                    android:textColor="#00F58A"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Direct Code Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_overlay_room_code"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="monospace"
                    android:hint="ENTER ROOM CODE"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:textColor="#F0F4F8"
                    android:textColorHint="#464E62"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Randomize Button with Vector Dice Icon -->
                <ImageView
                    android:id="@+id/btn_overlay_rand_code"
                    android:layout_width="38dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/bg_chip_channel"
                    android:clickable="true"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_dice_random" />

                <!-- Hop/Switch Button with Forward Arrow Icon -->
                <TextView
                    android:id="@+id/btn_overlay_join_code"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/bg_btn_deploy"
                    android:clickable="true"
                    android:drawableLeft="@drawable/ic_arrow_join"
                    android:drawablePadding="2dp"
                    android:focusable="false"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="HOP"
                    android:textColor="#0B0D13"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subheader: Recent Frequencies -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="RECENT FREQUENCIES (TAP TO HOP)"
                android:textColor="#7C869B"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Dynamic Recent Channels Container -->
            <LinearLayout
                android:id="@+id/deck_recent_channels_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
