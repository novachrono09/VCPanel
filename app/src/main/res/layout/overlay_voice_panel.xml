<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ================================================================== -->
    <!-- MODE A: COLLAPSED MINI-HUD PILL (36dp Height Telemetry Capsule)    -->
    <!-- ================================================================== -->
    <LinearLayout
        android:id="@+id/layout_hud_collapsed"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="4dp"
        android:visibility="visible">

        <!-- Machined Drag Grip Anchor (2 vertical knurled bars) -->
        <View
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="#464E62" />

        <View
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:layout_marginLeft="2dp"
            android:background="#464E62" />

        <!-- Live Speaking Status LED (state_activated=speaking, state_selected=muted) -->
        <View
            android:id="@+id/pill_voice_led"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/indicator_voice_led" />

        <!-- Squad CounterBadge -->
        <TextView
            android:id="@+id/pill_squad_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:text="01/01"
            android:textColor="#7C869B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Dot Separator -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:includeFontPadding="false"
            android:text="·"
            android:textColor="#464E62"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Center Telemetry & Live Squad Micro-Roster Deck -->
        <FrameLayout
            android:id="@+id/pill_roster_area"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <!-- Standby / Join Alert Banner -->
            <TextView
                android:id="@+id/pill_telemetry_readout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingLeft="2dp"
                android:paddingRight="6dp"
                android:singleLine="true"
                android:text="STANDBY"
                android:textColor="#F0F4F8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <!-- Dynamic Horizontal Roster of Connected Squadmates -->
            <LinearLayout
                android:id="@+id/pill_members_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="2dp"
                android:paddingRight="6dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 1dp Structural Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginRight="4dp"
            android:background="#262C3A" />

        <!-- Integrated 1-Tap Quick-Mute Capsule Button -->
        <TextView
            android:id="@+id/pill_btn_quick_mute"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_pill_mute_btn"
            android:clickable="true"
            android:focusable="false"
            android:fontFamily="monospace"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="MIC"
            android:textColor="#F0F4F8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ================================================================== -->
    <!-- MODE B: EXPANDED CONTROL DECK (272dp Tactical Command Module)      -->
    <!-- ================================================================== -->
    <LinearLayout
        android:id="@+id/layout_hud_expanded"
        android:layout_width="272dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hud_chassis"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <!-- 1. HEADER BAR: Drag Handle, Channel ID, Bitrate Badge, Collapse -->
        <LinearLayout
            android:id="@+id/deck_header_drag_zone"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tactile Grip Matrix -->
            <LinearLayout
                android:id="@+id/deck_drag_handle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="2dp"
                android:paddingRight="8dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="#464E62" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="2dp"
                    android:background="#464E62" />
            </LinearLayout>

            <!-- Room / Channel Title -->
            <TextView
                android:id="@+id/deck_channel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="CH // SQUAD-1"
                android:textColor="#F0F4F8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Audio Bitrate & Codec Telemetry Badge -->
            <TextView
                android:id="@+id/deck_bitrate_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_badge_telemetry"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="96K OPUS"
                android:textColor="#00F58A"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Collapse Trigger Button (—) -->
            <TextView
                android:id="@+id/deck_btn_collapse"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_chip_channel"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="—"
                android:textColor="#F0F4F8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Structural Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="#262C3A" />

        <!-- 2. QUICK ACTION GRID (4 High-Contrast Hardware Keycaps) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Action 1: Mic Toggle -->
            <LinearLayout
                android:id="@+id/btn_toggle_mic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactile_toggle"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="MIC"
                    android:textColor="#F0F4F8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_state_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="LIVE"
                    android:textColor="#00F58A"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Action 2: Deafen Toggle -->
            <LinearLayout
                android:id="@+id/btn_toggle_deafen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactile_toggle"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="DEAFEN"
                    android:textColor="#F0F4F8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_state_deafen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="NORM"
                    android:textColor="#7C869B"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Action 3: Audio Route Toggle -->
            <LinearLayout
                android:id="@+id/btn_toggle_route"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactile_toggle"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="ROUTE"
                    android:textColor="#F0F4F8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_state_route"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="SPKR"
                    android:textColor="#7C869B"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Action 4: Disconnect / Leave -->
            <LinearLayout
                android:id="@+id/btn_disconnect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tactile_danger"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="LINK"
                    android:textColor="#FF2A4B"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="DROP"
                    android:textColor="#F0F4F8"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. DUAL-TAB NAVIGATION (ROSTER vs CHANNELS) -->
        <LinearLayout
            android:id="@+id/deck_tab_bar"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Tab 1: Roster -->
            <TextView
                android:id="@+id/tab_btn_roster"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_button"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="👥 ROSTER"
                android:textColor="#FF5500"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Tab 2: Channels -->
            <TextView
                android:id="@+id/tab_btn_channels"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_button"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="📡 CHANNELS"
                android:textColor="#7C869B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TAB CONTENT 1: SQUAD ROSTER & GAIN TELEMETRY -->
        <LinearLayout
            android:id="@+id/deck_tab_content_roster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="SQUAD TELEMETRY"
                    android:textColor="#7C869B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="GAIN 0–200%"
                    android:textColor="#464E62"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Dynamic Roster Container -->
            <LinearLayout
                android:id="@+id/deck_roster_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Roster Footer: 1-Tap Copy Invite & Ping Telemetry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/deck_btn_copy_invite"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_channel"
                    android:clickable="true"
                    android:focusable="false"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="[+] COPY SQUAD LINK"
                    android:textColor="#F0F4F8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Live RTT Ping Telemetry Box -->
                <TextView
                    android:id="@+id/deck_ping_readout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_badge_telemetry"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="LIVE"
                    android:textColor="#00F58A"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- TAB CONTENT 2: CHANNELS & DIRECT FREQUENCY HOP -->
        <LinearLayout
            android:id="@+id/deck_tab_content_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Subheader: Switch Frequency -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="SWITCH FREQUENCY BY CODE"
                    android:textColor="#7C869B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deck_active_room_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="#SQ-884"
                    android:textColor="#00F58A"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Direct Code Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_overlay_room_code"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="monospace"
                    android:hint="ENTER ROOM CODE"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:textColor="#F0F4F8"
                    android:textColorHint="#464E62"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Randomize Dice Button -->
                <TextView
                    android:id="@+id/btn_overlay_rand_code"
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/bg_chip_channel"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="🎲"
                    android:textSize="13sp" />

                <!-- Hop/Switch Button -->
                <TextView
                    android:id="@+id/btn_overlay_join_code"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/bg_btn_deploy"
                    android:clickable="true"
                    android:focusable="false"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="HOP"
                    android:textColor="#0B0D13"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subheader: Recent Frequencies -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="RECENT FREQUENCIES (TAP TO HOP)"
                android:textColor="#7C869B"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Dynamic Recent Channels Container -->
            <LinearLayout
                android:id="@+id/deck_recent_channels_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
