<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed Feedback -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#232938" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#F0F4F8" />
        </shape>
    </item>
    <!-- Muted State (state_selected = true) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#280D14" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#FF2A4B" />
        </shape>
    </item>
    <!-- Live Mic State (Default) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181C26" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#262C3A" />
        </shape>
    </item>
</selector>
