<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active Dragging State -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size
                        android:width="10dp"
                        android:height="16dp" />
                    <solid android:color="#FF5500" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="rectangle">
                    <size
                        android:width="2dp"
                        android:height="8dp" />
                    <solid android:color="#090A0D" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default Fader Cap -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size
                        android:width="10dp"
                        android:height="16dp" />
                    <solid android:color="#F0F4F8" />
                    <corners android:radius="2dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#090A0D" />
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="rectangle">
                    <size
                        android:width="2dp"
                        android:height="8dp" />
                    <solid android:color="#090A0D" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
