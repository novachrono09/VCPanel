<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Chamfer Edge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3A4358" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Inner Recessed Frame -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#090A0D" />
            <corners android:radius="5dp" />
            <stroke
                android:width="1dp"
                android:color="#181C26" />
        </shape>
    </item>
    <!-- Top Telemetry Accent Bar (Signal Orange Micro-Lip) -->
    <item
        android:gravity="top|center_horizontal"
        android:top="1dp">
        <shape android:shape="rectangle">
            <size
                android:width="48dp"
                android:height="2dp" />
            <solid android:color="#FF5500" />
        </shape>
    </item>
</layer-list>
